#!/usr/bin/env bash
# rivetkit: the jobs you would otherwise need Docker commands for. Installed by install.sh.
set -euo pipefail
DIR=${RK_DIR:-/opt/rivet-kit}
REGISTRY_USER=${RK_REGISTRY_USER:-drunetic}
cd "$DIR" 2>/dev/null || { echo "No Rivet Kit install in $DIR"; exit 1; }
[ "$(id -u)" = 0 ] || { echo "Run as root."; exit 1; }

setenv() {  # setenv NAME value — replaces the line in .env, or adds it
  local tmp; tmp=$(mktemp)
  grep -v "^$1=" .env > "$tmp" || true
  printf '%s=%s\n' "$1" "$2" >> "$tmp"
  cat "$tmp" > .env && rm -f "$tmp"
}
getenv() { grep "^$1=" .env 2>/dev/null | tail -1 | cut -d= -f2-; }
health() { curl -fsS -m 3 "http://127.0.0.1:$(getenv APP_PORT || echo 3000)/api/health" 2>/dev/null; }
wait_up() { for _ in $(seq 1 60); do health >/dev/null && { echo "✓ Running: $(health)"; return 0; }; sleep 3; done; echo "✗ Not answering. See: rivetkit logs"; return 1; }

case "${1:-help}" in
  status)
    docker compose ps
    echo; health && echo || echo "App is not answering."
    echo "Address: $(getenv PUBLIC_BASE_URL)" ;;
  update)
    # The same steps as Settings → Updates, done by the updater container, which also rolls back if
    # the new version does not answer. This one stops at telling you.
    echo "Backing up first…"; docker compose exec -T backup sh /app/scripts/backup.sh now
    docker compose pull -q && docker compose up -d --remove-orphans && wait_up ;;
  backup)
    docker compose exec -T backup sh /app/scripts/backup.sh now && ls -lh backups | tail -4 ;;
  restore)
    dump=${2:-}; files=${3:-}
    [ -f "$dump" ] || { echo "Usage: rivetkit restore backups/rivetkit-<date>.dump [backups/files-<date>.tar.gz]"; exit 1; }
    echo "This REPLACES everything in Rivet Kit with that backup. Type RESTORE to carry on:"; read -r a
    [ "$a" = RESTORE ] || { echo "Nothing changed."; exit 1; }
    docker compose stop app backup
    docker compose exec -T db psql -U rivet -d postgres -v ON_ERROR_STOP=1 -c "DROP DATABASE IF EXISTS rivetkit WITH (FORCE)" -c "CREATE DATABASE rivetkit OWNER rivet"
    docker compose exec -T db pg_restore -U rivet -d rivetkit --no-owner --exit-on-error < "$dump"
    if [ -n "$files" ]; then
      docker compose run --rm -T --no-deps --entrypoint sh backup -c 'find /files -mindepth 1 -delete && tar -xzf - -C /files' < "$files"
    fi
    docker compose up -d && wait_up ;;
  tunnel)
    echo "In Cloudflare: Zero Trust → Networks → Tunnels → Create a tunnel → Cloudflared → Docker."
    echo "Copy the whole 'docker run …' command it shows and paste it here, then press Enter:"
    read -r cmd
    token=$(printf '%s' "$cmd" | sed 's/.*--token[[:space:]]*//' | tr -d '[:space:]')
    case "$token" in eyJ*) ;; *) echo "That does not look like a tunnel token (they start eyJ). Nothing changed."; exit 1 ;; esac
    read -rp "The address you will give it in Cloudflare (e.g. kit.yourdomain.co.uk): " host
    host=${host#https://}; host=${host%/}
    setenv TUNNEL_TOKEN "$token"; setenv COMPOSE_PROFILES tunnel; setenv TRUST_CLOUDFLARE_HEADERS 1
    [ -n "$host" ] && setenv PUBLIC_BASE_URL "https://$host"
    docker compose up -d --remove-orphans
    echo "✓ Tunnel connector started. In Cloudflare, add a route: hostname $host → HTTP, app:3000" ;;
  url)
    [ -n "${2:-}" ] || { echo "Usage: rivetkit url https://kit.yourdomain.co.uk"; exit 1; }
    setenv PUBLIC_BASE_URL "${2%/}"; docker compose up -d && wait_up ;;
  access-code)
    read -rsp "New access code (hidden as you type): " code; echo
    printf '%s' "$code" | docker login ghcr.io -u "$REGISTRY_USER" --password-stdin >/dev/null || { echo "Not accepted. Nothing changed."; exit 1; }
    setenv RIVET_ACCESS_CODE "$code"; docker compose up -d app && echo "✓ Access code updated" ;;
  logs) docker compose logs --tail "${3:-100}" -f "${2:-app}" ;;
  restart) docker compose up -d --remove-orphans && wait_up ;;
  *)
    cat <<'EOF'
rivetkit status              what is running, and the address
rivetkit update              back up, download the latest version, restart
rivetkit backup              make a backup now (they also run nightly, into /opt/rivet-kit/backups)
rivetkit restore DUMP [FILES]  put a backup back
rivetkit tunnel              add or change the Cloudflare Tunnel (paste Cloudflare's command)
rivetkit url ADDRESS         change the public address (QR labels use it)
rivetkit access-code         replace the access code
rivetkit logs [service]      follow the logs (app, db, backup, updater, cloudflared)
rivetkit restart             apply changes made to .env
EOF
    ;;
esac
