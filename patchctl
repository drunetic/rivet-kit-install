#!/usr/bin/env bash
# patchctl: the jobs you would otherwise need Docker commands for. Installed by install.sh.
set -euo pipefail
# The install folder: /opt/patch, or /opt/rivet-kit for an install from before the rename.
DIR=${PATCH_DIR:-$( [ -d /opt/patch ] || [ ! -d /opt/rivet-kit ] && echo /opt/patch || echo /opt/rivet-kit )}
REGISTRY_USER=${PATCH_REGISTRY_USER:-drunetic}
# .env from before the rename says RIVET_ACCESS_CODE; replace either.
CODE_KEY=$(grep -q '^RIVET_ACCESS_CODE=' "$DIR/.env" 2>/dev/null && ! grep -q '^PATCH_ACCESS_CODE=' "$DIR/.env" && echo RIVET_ACCESS_CODE || echo PATCH_ACCESS_CODE)
cd "$DIR" 2>/dev/null || { echo "No patch install in $DIR"; exit 1; }
[ "$(id -u)" = 0 ] || { echo "Run as root."; exit 1; }

setenv() {  # setenv NAME value — replaces the line in .env, or adds it
  local tmp; tmp=$(mktemp)
  grep -v "^$1=" .env > "$tmp" || true
  printf '%s=%s\n' "$1" "$2" >> "$tmp"
  cat "$tmp" > .env && rm -f "$tmp"
}
getenv() { grep "^$1=" .env 2>/dev/null | tail -1 | cut -d= -f2- || true; }
health() { curl -fsS -m 3 "http://127.0.0.1:$(getenv APP_PORT || echo 3000)/api/health" 2>/dev/null; }
wait_up() { for _ in $(seq 1 60); do health >/dev/null && { echo "✓ Running: $(health)"; return 0; }; sleep 3; done; echo "✗ Not answering. See: patchctl logs"; return 1; }

case "${1:-help}" in
  status)
    docker compose ps
    echo; health && echo || echo "App is not answering."
    echo "Address: $(getenv PUBLIC_BASE_URL)" ;;
  update)
    # The same steps as Settings → Updates, done by the updater container, which also rolls back if
    # the new version does not answer. This one stops at telling you.
    echo "Backing up first…"; docker compose exec -T backup sh /app/scripts/backup.sh now
    docker compose pull -q && docker compose up -d --remove-orphans && wait_up ;;
  backup)
    docker compose exec -T backup sh /app/scripts/backup.sh now && ls -lh backups | tail -4 ;;
  restore)
    dump=${2:-}; files=${3:-}
    [ -f "$dump" ] || { echo "Usage: patchctl restore backups/patch-<date>.dump [backups/files-<date>.tar.gz]"; exit 1; }
    echo "This REPLACES everything in patch with that backup. Type RESTORE to carry on:"; read -r a
    [ "$a" = RESTORE ] || { echo "Nothing changed."; exit 1; }
    docker compose stop app backup
    docker compose exec -T db psql -U rivet -d postgres -v ON_ERROR_STOP=1 -c "DROP DATABASE IF EXISTS rivetkit WITH (FORCE)" -c "CREATE DATABASE rivetkit OWNER rivet"
    docker compose exec -T db pg_restore -U rivet -d rivetkit --no-owner --exit-on-error < "$dump"
    if [ -n "$files" ]; then
      docker compose run --rm -T --no-deps --entrypoint sh backup -c 'find /files -mindepth 1 -delete && tar -xzf - -C /files' < "$files"
    fi
    docker compose up -d && wait_up ;;
  tunnel)
    echo "In Cloudflare: Zero Trust → Networks → Tunnels → Create a tunnel → Cloudflared → Docker."
    echo "Copy the whole 'docker run …' command it shows and paste it here, then press Enter:"
    read -r cmd
    token=$(printf '%s' "$cmd" | sed 's/.*--token[[:space:]]*//' | tr -d '[:space:]')
    case "$token" in eyJ*) ;; *) echo "That does not look like a tunnel token (they start eyJ). Nothing changed."; exit 1 ;; esac
    read -rp "The address you will give it in Cloudflare (e.g. kit.yourdomain.co.uk): " host
    host=${host#https://}; host=${host%/}
    setenv TUNNEL_TOKEN "$token"; setenv COMPOSE_PROFILES tunnel; setenv TRUST_CLOUDFLARE_HEADERS 1
    [ -n "$host" ] && setenv PUBLIC_BASE_URL "https://$host"
    docker compose up -d --remove-orphans
    echo "✓ Tunnel connector started. In Cloudflare, add a route: hostname $host → HTTP, app:3000"
    # HQ has a second address, for installs to download images from (docs/hq.md).
    if grep -q 'PATCH_ROLE: hq' docker-compose.yml 2>/dev/null; then
      read -rp "The images address (e.g. images.yourdomain.co.uk): " images
      images=${images#https://}; images=${images%/}
      [ -n "$images" ] && setenv HQ_IMAGES_ADDRESS "$images" && echo "  and a second: hostname $images → HTTP, front:8080"
    fi ;;
  url)
    [ -n "${2:-}" ] || { echo "Usage: patchctl url https://kit.yourdomain.co.uk"; exit 1; }
    setenv PUBLIC_BASE_URL "${2%/}"; docker compose up -d && wait_up ;;
  access-code)
    read -rsp "New access code (hidden as you type): " code; echo
    printf '%s' "$code" | docker login ghcr.io -u "$REGISTRY_USER" --password-stdin >/dev/null || { echo "Not accepted. Nothing changed."; exit 1; }
    setenv "$CODE_KEY" "$code"; docker compose up -d app && echo "✓ Access code updated" ;;
  clean)
    # HQ only: give back the disk taken by builds nobody can use any more. Its image store frees
    # space only when stopped and swept, so this waits until nothing is being built, stops the
    # store for a minute, sweeps it and starts it again. Run monthly by cron on HQ.
    grep -q 'PATCH_ROLE: hq' docker-compose.yml 2>/dev/null || { echo "clean is for patch HQ."; exit 1; }
    busy=$(docker compose exec -T db psql -U rivet -d rivetkit -Atc "SELECT COUNT(*) FROM hq_builds WHERE state = 'building'" 2>/dev/null || echo 1)
    [ "$busy" = 0 ] || { echo "A build is running; try again later."; exit 1; }
    docker compose stop registry
    docker compose run --rm --no-deps -T --entrypoint registry registry garbage-collect --delete-untagged /etc/distribution/config.yml | tail -3 || true
    docker compose start registry
    docker image prune -f >/dev/null; docker builder prune -f --filter until=336h >/dev/null 2>&1 || true
    echo "✓ Cleaned. Disk: $(df -h . | awk 'NR==2 {print $4 " free"}')" ;;
  licence)
    # The licence HQ issued for this company (lib/licence.ts). It decides updates only; patch keeps
    # working whatever happens to it.
    grep -q 'PATCH_ROLE: hq' docker-compose.yml 2>/dev/null && { echo "This is HQ: it issues licences rather than holding one."; exit 1; }
    grep -q 'PATCH_LICENCE_KEY' docker-compose.yml || { echo "This install's compose file is from before licences. Run the installer again (it keeps your settings), then this."; exit 1; }
    current=$(getenv PATCH_HQ_URL)
    read -rp "HQ's address (e.g. https://hq.yourdomain.co.uk)${current:+ [$current]}: " hq
    hq=${hq:-$current}
    [ -n "$hq" ] || { echo "HQ's address is needed. Nothing changed."; exit 1; }
    case "$hq" in http://*) echo "HQ's address must start https:// (the key would otherwise cross the internet readable). Nothing changed."; exit 1 ;; https://*) ;; *) hq="https://$hq" ;; esac
    while [ "${hq%/}" != "$hq" ]; do hq=${hq%/}; done
    read -rsp "Licence key (hidden as you type): " key; echo
    case "$key" in patch_*) ;; *) echo "That does not look like a licence key (they start patch_). Nothing changed."; exit 1 ;; esac
    # A check only: HQ says what state the licence is in and records nothing. The key goes in a
    # header read from a file descriptor, so it is never on a command line.
    answer=$(curl -sS -m 20 -X POST -H "@"<(printf 'Authorization: Bearer %s\n' "$key") -H 'Content-Type: application/json' \
      --data '{"check":true}' -w '\n%{http_code}' "$hq/api/hq/m/checkin" 2>/dev/null || true)
    code=$(printf '%s' "$answer" | tail -1); body=$(printf '%s' "$answer" | sed '$d')
    [ "$code" = 401 ] && { echo "HQ does not know that key. Nothing changed."; exit 1; }
    [ "$code" = 200 ] || { echo "Could not reach HQ at $hq (answered ${code:-nothing}). Nothing changed."; exit 1; }
    status=$(printf '%s' "$body" | sed -n 's/.*"status":"\([a-z]*\)".*/\1/p'); company=$(printf '%s' "$body" | sed -n 's/.*"company":"\([^"]*\)".*/\1/p')
    [ "$status" = revoked ] && { echo "That licence ($company) has been withdrawn. Nothing changed."; exit 1; }
    [ "$status" = ended ] && echo "Note: that licence ($company) has ended. patch works, but gets no updates until it is renewed."
    setenv PATCH_HQ_URL "$hq"; setenv PATCH_LICENCE_KEY "$key"
    docker compose up -d app && wait_up && echo "✓ Licensed to $company. It checks in within a couple of minutes: see Settings → Licence." ;;
  logs) docker compose logs --tail "${3:-100}" -f "${2:-app}" ;;
  restart) docker compose up -d --remove-orphans && wait_up ;;
  *)
    cat <<'EOF'
patchctl status              what is running, and the address
patchctl update              back up, download the latest version, restart
patchctl backup              make a backup now (they also run nightly, into /opt/patch/backups)
patchctl restore DUMP [FILES]  put a backup back
patchctl tunnel              add or change the Cloudflare Tunnel (paste Cloudflare's command)
patchctl url ADDRESS         change the public address (QR labels use it)
patchctl access-code         replace the access code
patchctl logs [service]      follow the logs (app, db, backup, updater, cloudflared)
patchctl restart             apply changes made to .env
patchctl licence             set this install's licence key and HQ's address
patchctl clean               (HQ) free the disk taken by builds nobody can use (monthly, by cron)
EOF
    ;;
esac
